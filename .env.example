# Runs with zero keys (Yahoo only for now). Add keys to light up more features.
# Database. Default (leave unset): a local SQLite file, no Docker needed.
# Recommended: PostgreSQL in Docker, started with `make db-up` (backend and frontend still run locally).
DATABASE_URL=postgresql+psycopg://quantlens:quantlens@127.0.0.1:5432/quantlens
# DATABASE_URL=sqlite:///./data/quantlens.db
TIMEZONE=Asia/Kolkata
LOG_LEVEL=INFO
DEFAULT_WATCHLIST=RELIANCE,TCS,HDFCBANK,INFY,ICICIBANK,SBIN,BHARTIARTL,ITC,LT,HINDUNILVR
RETRAIN_CRON=0 20 * * 1-5

# Angel One SmartAPI (Phase 2)
ANGEL_API_KEY=
ANGEL_CLIENT_CODE=
ANGEL_PIN=
ANGEL_TOTP_SECRET=

# News (Phase 5)
FINNHUB_KEY=
MARKETAUX_KEY=
ALPHAVANTAGE_KEY=
NEWSAPI_KEY=

# LLM (Phase 5A)
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=
GROQ_API_KEY=
# OpenRouter: one free key (openrouter.ai/keys) unlocks many free models. Enable "free model" use in your OpenRouter privacy settings.
OPENROUTER_API_KEY=
# Optional: put one model first. Run `make openrouter-check` to rank and test the free ones available right now.
OPENROUTER_MODEL=
OLLAMA_BASE_URL=
# Set to openrouter to use it before any paid provider you also have keys for.
LLM_DEFAULT_PROVIDER=openrouter
LLM_DAILY_TOKEN_BUDGET=200000
LLM_DAILY_USD_BUDGET=1.0
LLM_ENABLE_FORWARD_ONLY_FEATURES=true

# Background scheduler (off by default; makes network calls and may use LLM budget)
SCHEDULER_ENABLED=false
SCHEDULER_RETRAIN=false
SCHEDULER_MODELS=lgbm,logit,arima,garch
SCHEDULER_TICK_SECONDS=60
